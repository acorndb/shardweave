DROP TABLE IF EXISTS mtr_expr;
affected_rows: 0
CREATE TABLE mtr_expr ( id INT PRIMARY KEY, i INT, d DECIMAL(12,3), s VARCHAR(32), dt DATETIME(6) );
affected_rows: 0
INSERT INTO mtr_expr VALUES (1, 2, 1.500, 'Abc', '2026-11-01 01:02:03.000004'), (2, -3, NULL, 'abc ', NULL);
affected_rows: 2
# arithmetic
SELECT id, i+1, i*2, d/3, -i, ABS(i) FROM mtr_expr ORDER BY id;
id	i+1	i*2	d/3	-i	ABS(i)
1	3	4	0.5000000	-2	2
2	-2	-6	NULL	3	3
# case/if
SELECT id, CASE WHEN i > 0 THEN 'pos' ELSE 'neg' END, IF(i IS NULL, 'n', 'v') FROM mtr_expr ORDER BY id;
id	CASE WHEN i > 0 THEN 'pos' ELSE 'neg' END	IF(i IS NULL, 'n', 'v')
1	pos	v
2	neg	v
# strings
SELECT id, UPPER(s), LOWER(s), LENGTH(s), CONCAT(s, '!') FROM mtr_expr ORDER BY id;
id	UPPER(s)	LOWER(s)	LENGTH(s)	CONCAT(s, '!')
1	ABC	abc	3	Abc!
2	ABC 	abc 	4	abc !
# temporal
SELECT id, DATE_ADD(dt, INTERVAL 1 DAY), YEAR(dt), DATE_FORMAT(dt, '%Y-%m-%d %H:%i:%s') FROM mtr_expr ORDER BY id;
id	DATE_ADD(dt, INTERVAL 1 DAY)	YEAR(dt)	DATE_FORMAT(dt, '%Y-%m-%d %H:%i:%s')
1	2026-11-02 01:02:03.000004	2026	2026-11-01 01:02:03
2	NULL	NULL	NULL
# nulls
SELECT id, d IS NULL, COALESCE(d, 0), IFNULL(d, -1) FROM mtr_expr ORDER BY id;
id	d IS NULL	COALESCE(d, 0)	IFNULL(d, -1)
1	0	1.500	1.500
2	1	0.000	-1.000
# casts
SELECT CAST('12abc' AS SIGNED), CAST(1.9 AS SIGNED), CAST(1.234 AS DECIMAL(10,2));
CAST('12abc' AS SIGNED)	CAST(1.9 AS SIGNED)	CAST(1.234 AS DECIMAL(10,2))
12	2	1.23
DROP TABLE mtr_expr;
affected_rows: 0
