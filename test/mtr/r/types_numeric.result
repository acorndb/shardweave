DROP TABLE IF EXISTS mtr_num;
affected_rows: 0
CREATE TABLE mtr_num ( id INT PRIMARY KEY, ti TINYINT, uti TINYINT UNSIGNED, si SMALLINT, mi MEDIUMINT, i INT, ui INT UNSIGNED, bi BIGINT, ubi BIGINT UNSIGNED, d DECIMAL(30,10), f FLOAT, db DOUBLE, b BIT(16) );
