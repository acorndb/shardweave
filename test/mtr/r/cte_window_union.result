# CTE
WITH x AS (SELECT 1 AS n UNION ALL SELECT 2) SELECT n FROM x ORDER BY n;
n
1
2
# window functions
SELECT id, ROW_NUMBER() OVER (ORDER BY id) AS rn, RANK() OVER (ORDER BY v) AS rk, SUM(id) OVER (ORDER BY id) AS running FROM (SELECT 1 AS id, 'b' AS v UNION ALL SELECT 2,'a' UNION ALL SELECT 3,'a') t ORDER BY id;
id	rn	rk	running
1	1	3	1
2	2	1	3
3	3	1	6
# union
SELECT 1 AS x UNION SELECT 2 ORDER BY x;
x
1
2
SELECT 1 AS x UNION ALL SELECT 1 ORDER BY x;
x
1
1
