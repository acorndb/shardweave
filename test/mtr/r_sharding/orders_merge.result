# scatter aggregate
SELECT COUNT(*), SUM(amount), MIN(amount), MAX(amount) FROM orders;
COUNT(*)	SUM(amount)	MIN(amount)	MAX(amount)
80	76200	1	1904
SELECT COUNT(DISTINCT user_id) FROM orders;
COUNT(DISTINCT user_id)
80
# scatter order/limit
SELECT id, user_id, amount FROM orders ORDER BY id LIMIT 10;
id	user_id	amount
1	0	1
2	1	2
3	2	3
4	3	4
5	4	101
6	5	102
7	6	103
8	7	104
9	8	201
10	9	202
# scatter group by (key in output)
SELECT user_id, COUNT(*) FROM orders GROUP BY user_id ORDER BY user_id LIMIT 10;
user_id	COUNT(*)
0	1
1	1
2	1
3	1
4	1
5	1
6	1
7	1
8	1
9	1
# scatter distinct
SELECT DISTINCT amount FROM orders ORDER BY amount LIMIT 10;
