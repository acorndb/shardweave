# group by key
SELECT user_id, COUNT(*) FROM orders GROUP BY user_id ORDER BY user_id LIMIT 10;
user_id	COUNT(*)
0	1
1	1
2	1
3	1
4	1
5	1
6	1
7	1
8	1
9	1
# having on aggregate in output
SELECT user_id, SUM(amount) FROM orders GROUP BY user_id HAVING SUM(amount) > 100 ORDER BY user_id LIMIT 5;
user_id	SUM(amount)
4	101
5	102
6	103
7	104
8	201
